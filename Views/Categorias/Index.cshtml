@model List<Categoria>

<h1>Categorias</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Nueva Categoria</a>

@if (Model.Any()) {
<table class="table table-stripeda">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th style="width: 1%"></th>

        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model){
            <tr>
                <td>@p.Nombre</td>
                <td>@p.Descripcion</td>
                <td>
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                        <button type="button" class="btn btn-sm btn-danger"
                                data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                data-id="@p.Id" data-nombre="@p.Nombre">
                            Eliminar
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Seguro que quieres eliminar <strong id="modalNombreCategoria"></strong>?
                Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminar" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

} else { <p>No hay Categorias todavía.</p> }

@section Scripts {
    <script>
        const modal = document.getElementById('modalEliminar');
        modal.addEventListener('show.bs.modal', function (event) {
            // el botón que disparó el modal
            const boton = event.relatedTarget;

            // leerle su carga de datos
            const id = boton.getAttribute('data-id');
            const nombre = boton.getAttribute('data-nombre');

            // rellenar los huecos
            document.getElementById('modalNombreCategoria').textContent = nombre;
            document.getElementById('formEliminar').action = '/Categorias/Delete/' + id;
        });
    </script>
}
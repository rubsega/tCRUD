@model List<Venta>

<h1>Ventas</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Nueva Venta</a>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Productos</th>
                <th class="text-end">Total</th>
                <th style="width: 1%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.Id</td>
                    <td>@v.Fecha.ToLocalTime().ToString("g")</td>
                    <td>@v.Items.Sum(i => i.Cantidad)</td>
                    <td class="text-end">@v.Total.ToString("C")</td>
                    <td>
                        <a asp-action="Items" asp-route-id="@v.Id" class="btn btn-sm btn-info">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay ventas registradas todavía.</p>
}
@model List<ProductoReporteViewModel>

<h1>Productos más comprados</h1>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Producto</th>
                <th class="text-end">Unidades compradas</th>
                <th class="text-end">Nº de compras</th>
            </tr>
        </thead>
        <tbody>
            @{ var pos = 1; }
            @foreach (var r in Model)
            {
                <tr>
                    <td>@pos</td>
                    <td>@r.Producto</td>
                    <td class="text-end">@r.UnidadesTotales</td>
                    <td class="text-end">@r.NumeroDeCompras</td>
                </tr>
                pos++;
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Aún no hay compras registradas.</p>
}
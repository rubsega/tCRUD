@model Compra

<h1>Compra #@Model.Id</h1>
<p class="text-muted">@Model.Fecha.ToLocalTime().ToString("g")</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Costo unitario</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@(item.Producto?.Nombre ?? "Producto eliminado")</td>
                <td>@item.Cantidad</td>
                <td>@item.PrecioCompra.ToString("C")</td>
                <td class="text-end">@item.Subtotal.ToString("C")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total:</th>
            <th class="text-end">@Model.Total.ToString("C")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-secondary">Volver</a>